# Copy to .env and adjust. EXPO_PUBLIC_* values are inlined at build time,
# so restart the dev server after changing one.

# mock  — serves the in-memory IndoMart dataset, no backend needed (default)
# live  — talks to EXPO_PUBLIC_API_URL
EXPO_PUBLIC_API_MODE=mock

# Only used in live mode. Switching modes changes nothing else in the app.
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Abort a request after this long; surfaces as a timeout error.
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# Artificial delay in mock mode, so loading states are actually visible.
EXPO_PUBLIC_MOCK_LATENCY_MS=220
