# syntax=docker/dockerfile:1

# The Expo dev server, for hot reload in a container.
#
# The production image (see Dockerfile) is the one to reach for when the point
# is simply to look at the app. This one exists for editing the source with the
# toolchain pinned inside a container.
#
# Caveat worth knowing before you rely on it: Metro's file watching over a
# bind mount from a Windows or macOS host is slower and less reliable than it
# is natively. If a save does not trigger a reload, that is why — the fallback
# is `npm start` on the host.

FROM node:22-bookworm-slim

WORKDIR /app

COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci

COPY . .

ENV EXPO_PUBLIC_API_MODE=mock \
    EXPO_NO_TELEMETRY=1 \
    # Metro cannot use inotify across a bind mount from a non-Linux host.
    CHOKIDAR_USEPOLLING=1 \
    WATCHPACK_POLLING=true

EXPOSE 8081

# Binds to every interface so the port is reachable from the host.
CMD ["npx", "expo", "start", "--web", "--port", "8081"]
